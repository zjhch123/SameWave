{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "NSAudioCaptureUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SameWave taps the audio of your meeting app to transcribe and translate it on-device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SameWave 采集会议应用的音频，在设备上进行转录和翻译。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used only if you choose to caption your own microphone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在你选择为自己的麦克风生成字幕时使用。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SameWave uses on-device speech recognition to transcribe meeting audio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SameWave 使用设备端语音识别来转录会议音频。"
          }
        }
      }
    }
  }
}
